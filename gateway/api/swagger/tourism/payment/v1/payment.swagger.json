          "type": "string"
        }
      }
    },
    "v1CheckoutRequest": {
      "type": "object"
    },
    "v1CheckoutResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TourPurchaseToken"
          }
        }
      }
    },
    "v1HasTokenResponse": {
      "type": "object",
      "properties": {
        "hasToken": {
          "type": "boolean"
        }
      }
    },
    "v1ListMyTokensResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TourPurchaseToken"
          }
        }
      }
    },
    "v1OrderItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tourId": {
          "type": "string"
        },
        "tourName": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "format": "double"
        },
        "addedAt": {
          "type": "string"
        }
      }
    },
    "v1ShoppingCart": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrderItem"
          }
        },
        "totalPrice": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1TourPurchaseToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "tourId": {
          "type": "string"
        },
        "tourName": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "format": "double"
        },
        "purchasedAt": {
          "type": "string"
        }
      }
    }
  }
}
