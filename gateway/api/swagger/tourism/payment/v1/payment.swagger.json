{
  "swagger": "2.0",
  "info": {
    "title": "Payment API",
    "description": "Shopping cart and purchase token management",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "PaymentService"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/cart": {
      "get": {
        "operationId": "PaymentService_GetCart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShoppingCart"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/api/v1/cart/checkout": {
      "post": {
        "operationId": "PaymentService_Checkout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CheckoutResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CheckoutRequest"
            }
          }
        ],
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/api/v1/cart/items": {
      "post": {
        "operationId": "PaymentService_AddToCart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShoppingCart"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AddToCartRequest"
            }
          }
        ],
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/api/v1/cart/items/{tourId}": {
      "delete": {
        "operationId": "PaymentService_RemoveFromCart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ShoppingCart"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "tourId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/api/v1/purchases": {
      "get": {
        "operationId": "PaymentService_ListMyTokens",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListMyTokensResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "PaymentService"
        ]
      }
    },
    "/api/v1/purchases/check/{tourId}": {
      "get": {
        "operationId": "PaymentService_HasToken",
        "responses": {
          "200": {
            "description": "A successful response.",
