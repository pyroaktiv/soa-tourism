{
  "id": null,
  "uid": "log-aggregation",
  "title": "Log Aggregation",
  "description": "Centralized logs from all Docker Compose services via Promtail → Loki",
  "tags": ["logs", "loki"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "current": {},
        "includeAll": false,
        "label": "Datasource",
        "name": "ds_loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "loki", "uid": "${ds_loki}"},
        "definition": "label_values(service)",
        "includeAll": true,
        "allValue": ".+",
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "datasource": {"type": "loki", "uid": "${ds_loki}"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 7},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "sum by(service) (count_over_time({service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {"mode": "normal", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}
      }
    },
    {
      "id": 2,
      "title": "Log Stream",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "${ds_loki}"},
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 16},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds_loki}"},
          "expr": "{service=~\"$service\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
